{
  "ConnectionStrings": { "Raven": "Data Source=raven.db" },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Crawl4AI": {
    "Local": {
      "BaseUrl": "http://localhost:11235",
      "HealthPath": "/health",
      "CrawlPath": "/crawl",
      "TimeoutSeconds": 60
    }
  },
  "ChatResearch": {
    "MaxResearchRounds": 3,
    "MaxSearchCalls": 3,
    "MaxCrawlCalls": 5,
    "MaxResultsPerSearch": 5,
    "MaxParallelCrawls": 2,
    "TurnDeadlineSeconds": 150,
    "FinalReserveSeconds": 35,
    "PlannerTimeoutSeconds": 30,
    "FinalTimeoutSeconds": 45,
    "MaxContextCharacters": 64000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
