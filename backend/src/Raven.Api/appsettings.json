{
  "ConnectionStrings": { "Raven": "Data Source=raven.db" },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Crawl4AI": {
    "Local": {
      "BaseUrl": "http://localhost:11235",
      "HealthPath": "/health",
      "CrawlPath": "/crawl",
      "TimeoutSeconds": 60,
      "EnableContentPruning": true,
      "PruningThreshold": 0.48,
      "PruningMinWordThreshold": 20
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
